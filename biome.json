{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": [{ "path": "./tools/biome/no-fixed-waits.grit", "includes": ["tests/browser/**"] }],
  "files": {
    "includes": [
      "app/js/**",
      "app/kit/check-controls.js",
      "app/kit/check-layout.js",
      "app/kit/check-text.js",
      "app/kit/check.js",
      "app/kit/kit.js",
      "app/kit/diagram.js",
      "app/kit/drawn.js",
      "app/theme.js",
      "server/**",
      "shared/**",
      "tools/**",
      "tests/**",
      "playwright.config.mjs",
      "!server/corpus/books",
      "!.claude",
      "!app/kit/vendor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off",
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300
          }
        }
      },
      "complexity": {
        "noForEach": "off",
        "useArrowFunction": "off",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50
          }
        }
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImportCycles": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    { "includes": ["tests/lint.test.mjs", "tests/lint-security.test.mjs"], "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } } },
