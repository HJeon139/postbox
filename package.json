{
  "name": "postbox",
  "version": "0.27.0",
  "description": "A chat room for directing several AI agents, where agents reply with software they write.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "bin": {
    "postbox": "bin/postbox.mjs"
  },
  "files": [
    "bin/",
    "app/",
    "server/",
    "shared/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/postbox.mjs",
    "demo": "node tools/demo.mjs",
    "test": "node --test --import ./tests/guard.mjs tests/*.test.mjs",
    "test:coverage": "node --test --import ./tests/guard.mjs --experimental-test-coverage --test-coverage-include=shared/** --test-coverage-include=server/** --test-coverage-include=tools/lint-*.mjs tests/*.test.mjs",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc -p jsconfig.json",
    "lint:project": "node tools/lint-tokens.mjs && node tools/lint-dom.mjs && node tools/lint-copy.mjs",
    "check:contrast": "node tools/contrast.mjs app/workbench.css",
    "check": "npm run lint && npm run typecheck && npm run lint:project && npm run check:contrast && npm test",
    "check:browser": "node tools/check-all.mjs",
    "shoot:mockups": "node tools/shoot.mjs",
    "shoot:app": "node tools/shoot-app.mjs",
    "uat": "node tools/uat-run.mjs",
    "lint:commits": "node tools/lint-commits.mjs",
    "release": "node tools/release.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "prepack": "node server/build-info.mjs pack",
    "postpack": "node server/build-info.mjs unpack"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "axe-core": "4.14.0",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "kokoro-js": "1.2.1"
  }
}
